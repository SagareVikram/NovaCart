# =========================================================
# NOVACART SERVER ENVIRONMENT
# =========================================================

# ---------------------------------------------------------
# APPLICATION
# ---------------------------------------------------------

NODE_ENV=development
PORT=5000


# ---------------------------------------------------------
# MONGODB
# ---------------------------------------------------------

# Local MongoDB example:
# MONGODB_URI=mongodb://127.0.0.1:27017/novacart

# MongoDB Atlas example:
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/novacart?retryWrites=true&w=majority


# ---------------------------------------------------------
# JWT AUTHENTICATION
# ---------------------------------------------------------

# Use a long, random secret in the real .env file.
JWT_SECRET=replace_with_a_long_random_secure_secret

# Examples:
# 1d
# 7d
# 30d
JWT_EXPIRES_IN=7d


# ---------------------------------------------------------
# FRONTEND / CORS
# ---------------------------------------------------------

# Local React/Vite frontend
CLIENT_URL=http://localhost:5173

# Production Vercel frontend.
# Fill this after deployment.
VERCEL_CLIENT_URL=https://your-novacart-frontend.vercel.app


# ---------------------------------------------------------
# CLOUDINARY
# ---------------------------------------------------------

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


# ---------------------------------------------------------
# INITIAL ADMIN ACCOUNT
# ---------------------------------------------------------

# This account is created automatically at server startup
# if an administrator with this email does not already exist.

ADMIN_NAME=NovaCart Admin
ADMIN_EMAIL=admin@novacart.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password